library (ztimer) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 3.30;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
  }

  cell ("ztimer") {
    area : 25345.807 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0119;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.36783");
	}
	fall_constraint(scalar) {
          values("0.31546");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.06520");
	}
	fall_constraint(scalar) {
          values("-0.15672");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0127;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.36544");
	}
	fall_constraint(scalar) {
          values("0.31403");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.06276");
	}
	fall_constraint(scalar) {
          values("-0.15519");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0092;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.37534");
	}
	fall_constraint(scalar) {
          values("0.31981");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.07257");
	}
	fall_constraint(scalar) {
          values("-0.16143");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0056;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.32702,1.33222,1.34672,1.38521,1.50312,1.84404,2.94303");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.04325,0.04721,0.05850,0.09086,0.19482,0.50256,1.50163");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.08909,1.09173,1.09831,1.11494,1.15937,1.27704,1.64923");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.02986,0.03140,0.03510,0.04483,0.07533,0.17076,0.48768");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0345;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.38635");
	}
	cell_fall(scalar) {
          values("0.37671");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.39209");
	}
	cell_fall(scalar) {
          values("0.38261");
	}
      }
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0142;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
