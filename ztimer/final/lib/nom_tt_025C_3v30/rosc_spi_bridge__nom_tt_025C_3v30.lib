library (rosc_spi_bridge) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 3.30;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
  }

  cell ("rosc_spi_bridge") {
    area : 25345.889 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0119;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.47651");
	}
	fall_constraint(scalar) {
          values("0.42417");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17389");
	}
	fall_constraint(scalar) {
          values("-0.26542");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0099;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.48015");
	}
	fall_constraint(scalar) {
          values("0.42559");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17752");
	}
	fall_constraint(scalar) {
          values("-0.26706");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0135;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.47184");
	}
	fall_constraint(scalar) {
          values("0.42135");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.16912");
	}
	fall_constraint(scalar) {
          values("-0.26240");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0024;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.75150,1.75672,1.77119,1.80967,1.92754,2.26848,3.36750");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.04326,0.04721,0.05851,0.09086,0.19482,0.50256,1.50163");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.57747,1.58011,1.58670,1.60332,1.64776,1.76543,2.13762");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.02986,0.03139,0.03509,0.04482,0.07533,0.17076,0.48768");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0374;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.48002");
	}
	cell_fall(scalar) {
          values("0.45981");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.49724");
	}
	cell_fall(scalar) {
          values("0.47758");
	}
      }
    }
    pin("rosc_enable_i") {
      direction : input;
      capacitance : 0.0112;
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0691;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0078;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0221;
    }
  }

}
