library (rosc_spi_bridge) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 3.30;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
  }

  cell ("rosc_spi_bridge") {
    area : 25345.889 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0124;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.48078");
	}
	fall_constraint(scalar) {
          values("0.42892");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17811");
	}
	fall_constraint(scalar) {
          values("-0.27013");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0101;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.48466");
	}
	fall_constraint(scalar) {
          values("0.43034");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.18204");
	}
	fall_constraint(scalar) {
          values("-0.27179");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0142;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.47520");
	}
	fall_constraint(scalar) {
          values("0.42556");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17241");
	}
	fall_constraint(scalar) {
          values("-0.26653");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0026;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.76838,1.77361,1.78807,1.82654,1.94441,2.28536,3.38438");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.04327,0.04721,0.05851,0.09086,0.19482,0.50256,1.50163");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.60093,1.60356,1.61015,1.62678,1.67121,1.78888,2.16107");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.02987,0.03139,0.03509,0.04482,0.07533,0.17076,0.48768");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0389;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.48384");
	}
	cell_fall(scalar) {
          values("0.46275");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.50281");
	}
	cell_fall(scalar) {
          values("0.48236");
	}
      }
    }
    pin("rosc_enable_i") {
      direction : input;
      capacitance : 0.0113;
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0761;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0081;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0230;
    }
  }

}
