library (rosc_spi_bridge) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 3.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
  }

  cell ("rosc_spi_bridge") {
    area : 25345.889 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0122;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.38614");
	}
	fall_constraint(scalar) {
          values("0.35183");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.15925");
	}
	fall_constraint(scalar) {
          values("-0.21623");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0099;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.38921");
	}
	fall_constraint(scalar) {
          values("0.35300");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.16226");
	}
	fall_constraint(scalar) {
          values("-0.21751");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0140;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.38172");
	}
	fall_constraint(scalar) {
          values("0.34901");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.15493");
	}
	fall_constraint(scalar) {
          values("-0.21333");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0026;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("1.39744,1.40239,1.41569,1.45000,1.54928,1.89047,2.97942");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("0.03590,0.03979,0.05021,0.07955,0.16904,0.48396,1.49574");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("1.26559,1.26798,1.27448,1.28967,1.32854,1.45157,1.83960");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("0.02658,0.02763,0.03126,0.04024,0.06727,0.16946,0.50363");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0381;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.38101");
	}
	cell_fall(scalar) {
          values("0.36596");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.39929");
	}
	cell_fall(scalar) {
          values("0.38477");
	}
      }
    }
    pin("rosc_enable_i") {
      direction : input;
      capacitance : 0.0111;
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0761;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0080;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0225;
    }
  }

}
