library (rosc_spi_bridge) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 3.00;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00140,  0.00380,  0.00900,  0.02800,  0.08200,  0.25200");
  }

  cell ("rosc_spi_bridge") {
    area : 25345.889 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0125;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.63880");
	}
	fall_constraint(scalar) {
          values("0.56520");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.20993");
	}
	fall_constraint(scalar) {
          values("-0.34720");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0102;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.64400");
	}
	fall_constraint(scalar) {
          values("0.56688");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.21483");
	}
	fall_constraint(scalar) {
          values("-0.34908");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0143;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.63138");
	}
	fall_constraint(scalar) {
          values("0.56085");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.20281");
	}
	fall_constraint(scalar) {
          values("-0.34259");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0026;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00140,  0.00380,  0.00900,  0.02800,  0.08200,  0.25200");
          values("2.36307,2.36970,2.38699,2.42319,2.55075,2.90413,4.00669");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00140,  0.00380,  0.00900,  0.02800,  0.08200,  0.25200");
          values("0.05473,0.05974,0.07324,0.10294,0.21223,0.52250,1.49882");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00140,  0.00380,  0.00900,  0.02800,  0.08200,  0.25200");
          values("2.13782,2.14086,2.14846,2.16346,2.20991,2.32606,2.67733");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00140,  0.00380,  0.00900,  0.02800,  0.08200,  0.25200");
          values("0.03555,0.03734,0.04147,0.05009,0.08092,0.17171,0.46638");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0396;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.64914");
	}
	cell_fall(scalar) {
          values("0.61607");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.66954");
	}
	cell_fall(scalar) {
          values("0.63687");
	}
      }
    }
    pin("rosc_enable_i") {
      direction : input;
      capacitance : 0.0116;
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0763;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0082;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0234;
    }
  }

}
