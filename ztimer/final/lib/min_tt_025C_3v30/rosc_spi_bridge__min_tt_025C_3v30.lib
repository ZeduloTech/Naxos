library (rosc_spi_bridge) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 3.30;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
  }

  cell ("rosc_spi_bridge") {
    area : 25345.889 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0115;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.47313");
	}
	fall_constraint(scalar) {
          values("0.42037");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17056");
	}
	fall_constraint(scalar) {
          values("-0.26165");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0097;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.47654");
	}
	fall_constraint(scalar) {
          values("0.42178");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.17390");
	}
	fall_constraint(scalar) {
          values("-0.26326");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0128;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.46920");
	}
	fall_constraint(scalar) {
          values("0.41800");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.16654");
	}
	fall_constraint(scalar) {
          values("-0.25912");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0021;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.73764,1.74286,1.75733,1.79581,1.91369,2.25463,3.35364");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.04326,0.04721,0.05850,0.09086,0.19482,0.50256,1.50163");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.55816,1.56080,1.56739,1.58401,1.62844,1.74612,2.11831");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.02986,0.03139,0.03509,0.04482,0.07533,0.17076,0.48768");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0362;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.47705");
	}
	cell_fall(scalar) {
          values("0.45768");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.49276");
	}
	cell_fall(scalar) {
          values("0.47373");
	}
      }
    }
    pin("rosc_enable_i") {
      direction : input;
      capacitance : 0.0110;
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0631;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0076;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0213;
    }
  }

}
