library (ztimer) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 3.30;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
  }

  cell ("ztimer") {
    area : 25345.807 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0114;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.36704");
	}
	fall_constraint(scalar) {
          values("0.31410");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.06445");
	}
	fall_constraint(scalar) {
          values("-0.15541");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0122;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.36486");
	}
	fall_constraint(scalar) {
          values("0.31277");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.06222");
	}
	fall_constraint(scalar) {
          values("-0.15400");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0090;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.37351");
	}
	fall_constraint(scalar) {
          values("0.31784");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.07074");
	}
	fall_constraint(scalar) {
          values("-0.15947");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0053;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.32262,1.32782,1.34232,1.38082,1.49872,1.83964,2.93863");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.04325,0.04721,0.05850,0.09086,0.19482,0.50256,1.50163");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("1.08623,1.08886,1.09545,1.11207,1.15650,1.27418,1.64636");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00145,  0.00410,  0.01150,  0.03510,  0.10500,  0.33200");
          values("0.02985,0.03140,0.03510,0.04483,0.07533,0.17076,0.48768");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0335;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.38415");
	}
	cell_fall(scalar) {
          values("0.37496");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.38918");
	}
	cell_fall(scalar) {
          values("0.38013");
	}
      }
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0136;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
