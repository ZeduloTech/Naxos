library (rosc_spi_bridge) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 3.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
  }

  cell ("rosc_spi_bridge") {
    area : 25345.889 
    is_macro_cell : true;
    pin("cio_csb_i") {
      direction : input;
      capacitance : 0.0114;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.37940");
	}
	fall_constraint(scalar) {
          values("0.34442");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.15251");
	}
	fall_constraint(scalar) {
          values("-0.20885");
	}
      }
    }
    pin("cio_sck_i") {
      direction : input;
      capacitance : 0.0095;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.38214");
	}
	fall_constraint(scalar) {
          values("0.34554");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.15519");
	}
	fall_constraint(scalar) {
          values("-0.21008");
	}
      }
    }
    pin("cio_sd_i") {
      direction : input;
      capacitance : 0.0127;
      timing() {
        related_pin : "clk_i";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.37629");
	}
	fall_constraint(scalar) {
          values("0.34244");
	}
      }
      timing() {
        related_pin : "clk_i";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.14946");
	}
	fall_constraint(scalar) {
          values("-0.20681");
	}
      }
    }
    pin("cio_sd_o") {
      direction : output;
      capacitance : 0.0021;
      timing() {
        related_pin : "clk_i";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("1.37077,1.37573,1.38902,1.42334,1.52263,1.86381,2.95276");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("0.03589,0.03979,0.05021,0.07954,0.16904,0.48396,1.49574");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("1.23068,1.23307,1.23956,1.25476,1.29363,1.41666,1.80468");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00162,  0.00470,  0.01310,  0.03830,  0.12700,  0.41200");
          values("0.02658,0.02763,0.03126,0.04024,0.06727,0.16946,0.50363");
	}
      }
    }
    pin("clk_i") {
      direction : input;
      clock : true;
      capacitance : 0.0354;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.37563");
	}
	cell_fall(scalar) {
          values("0.36201");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.39061");
	}
	cell_fall(scalar) {
          values("0.37739");
	}
      }
    }
    pin("rosc_enable_i") {
      direction : input;
      capacitance : 0.0108;
    }
    pin("rst_ni") {
      direction : input;
      capacitance : 0.0632;
    }
    pin("start_i") {
      direction : input;
      capacitance : 0.0075;
    }
    pin("stop_i") {
      direction : input;
      capacitance : 0.0209;
    }
  }

}
